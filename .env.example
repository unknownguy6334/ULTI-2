# Copy to .env for local development. Keep all secrets out of source control.
NODE_ENV=development
GADWAL_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=
NEON_AUTH_URL=
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=
FRAME_ANCESTORS='self'
TRUSTED_PROXY_CIDRS=
# Required only when production traffic is protected by the Gadwal proxy header check. Generate a unique high-entropy value.
GADWAL_PROXY_SECRET=
DIRECT_DEPLOYMENT=true
REQUIRE_TRUSTED_PROXY=false
ENABLE_DIAGNOSTIC_MODELS_ENDPOINT=true
DEBUG_METRICS=false
PRODUCTION_SOURCEMAPS=false

# Optional deployment/build identifier used in diagnostics.
GADWAL_RELEASE=
